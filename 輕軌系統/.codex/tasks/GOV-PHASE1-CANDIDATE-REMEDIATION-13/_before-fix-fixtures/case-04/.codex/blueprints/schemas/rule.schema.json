{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ntmc.local/codex/schemas/rule.schema.json",
  "x-governance-schema-version": 1,
  "type": "object", "additionalProperties": false,
  "required": ["rule_id", "version", "category", "rule_class", "authority_effect", "status", "statement", "verification", "enforcement", "sources", "owner", "approved_at", "open_questions"],
  "properties": {
    "rule_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "version": {"type": "integer", "minimum": 1},
    "category": {"enum": ["governance", "database", "security", "review", "evidence", "confidentiality", "domain", "compatibility"]},
    "rule_class": {"enum": ["governance_control", "technical_constraint", "railway_domain_candidate", "railway_domain_authority"]},
    "authority_effect": {"enum": ["procedural_governance", "technical_constraint", "candidate_only", "unsupported"]},
    "status": {"enum": ["proposed", "candidate", "unverified", "confirmed", "deprecated", "rejected"]},
    "statement": {"type": "string", "minLength": 1},
    "scope": {"type":"array","items":{"type":"string"}},
    "canonicalization_version": {"enum":["RULE-CORE-V1",null]},
    "rule_content_sha256": {"type":["string","null"],"pattern":"^[A-Fa-f0-9]{64}$"},
    "applies_when": {"type": "array", "items": {"type": "string"}},
    "prohibited": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": "object"},
    "enforcement": {"type": "object"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["type", "ref"], "properties": {"type": {"enum": ["human-approval", "document", "implementation", "migration", "test", "report"]}, "ref": {"type": "string", "minLength": 1}, "section": {"type": "string"}, "source_verification_status": {"enum": ["VERIFIED", "UNVERIFIED"]}}}},
    "owner": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"]},
    "human_owner": {"type": "object", "additionalProperties": false, "required": ["role", "owner_id"], "properties": {"role": {"type": "string", "minLength": 1}, "owner_id": {"type": "string", "minLength": 1}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["approval_artifact_id", "approved_at", "approval_scope"], "properties": {"approval_artifact_id": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "format": "date-time"}, "approval_scope": {"type": "string", "minLength": 1}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["source_type", "source_reference", "source_hash", "source_verification_status"], "properties": {"source_type": {"const": "human-approval"}, "source_reference": {"type": "string", "minLength": 1}, "source_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "source_verification_status": {"const": "VERIFIED"}}},
    "effective_from": {"type": "string", "format": "date-time"},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  }
}
