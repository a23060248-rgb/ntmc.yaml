{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ntmc.local/codex/schemas/task-intent.schema.json",
  "x-governance-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "task_id", "title", "task_type", "objective", "business_reason", "scope", "acceptance_criteria", "requested_by"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["DRAFT", "IN_PROGRESS", "READY_FOR_REVIEW", "CLOSED"]},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 1},
    "task_type": {"enum": ["governance", "documentation", "feature", "bugfix", "migration", "review"]},
    "objective": {"type": "string", "minLength": 1},
    "business_reason": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["include", "exclude", "product_changes_allowed", "database_operations_allowed"],
      "properties": {
        "include": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exclude": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "product_changes_allowed": {"type": "boolean"},
        "database_operations_allowed": {"type": "boolean"},
        "git_mutation_allowed": {"const": false}
      }
    },
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "requested_by": {"type": "string", "minLength": 1},
    "retained_phase1_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "removed_phase1_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authorization": {"type": "string", "minLength": 1}
  }
}
