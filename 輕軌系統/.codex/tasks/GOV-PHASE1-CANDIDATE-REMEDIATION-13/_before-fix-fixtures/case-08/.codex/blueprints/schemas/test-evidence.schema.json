{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://ntmc.local/codex/schemas/test-evidence.schema.json", "x-governance-schema-version": 1, "type": "object", "additionalProperties": false,
  "required": ["schema_version", "task_id", "evidence_mode", "commands", "checks", "product_tests_run", "database_operations_run", "limitations"],
  "properties": {
    "schema_version": {"const": 1}, "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"}, "evidence_mode": {"type": "string", "minLength": 1},
    "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "requirements": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["requirement_id","semantic_category","criticality","required_for_levels","required_execution_categories"],"properties":{"requirement_id":{"type":"string","minLength":1},"semantic_category":{"type":"string","minLength":1},"criticality":{"enum":["LOW","MEDIUM","HIGH","CRITICAL"]},"required_for_levels":{"type":"array","items":{"enum":["L1","L2","L3"]}},"required_execution_categories":{"type":"array","items":{"type":"string"}}}}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["check_id", "requirement_id", "result", "note"], "properties": {"check_id": {"type": "string", "minLength": 1}, "requirement_id": {"type": "string", "minLength": 1}, "result": {"enum": ["PASS", "PASS_WITH_LIMITATION", "FAIL", "NOT_APPLICABLE", "NOT_VERIFIED"]}, "note": {"type": "string", "minLength": 1}}}},
    "product_tests_run": {"type": "boolean"}, "database_operations_run": {"type": "boolean"}, "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
