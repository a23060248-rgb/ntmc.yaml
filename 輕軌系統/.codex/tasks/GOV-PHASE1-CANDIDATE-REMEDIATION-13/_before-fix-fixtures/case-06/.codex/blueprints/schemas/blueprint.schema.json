{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ntmc.local/codex/schemas/blueprint.schema.json",
  "x-governance-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "blueprint_id", "task_id", "risk", "scope", "allowed_paths", "agent_assignments", "applicable_rules", "candidate_rules", "required_agents", "execution", "evidence_required", "rollback_restore", "human_approval", "stop_conditions"],
  "properties": {
    "schema_version": {"const": 1},
    "blueprint_id": {"type": "string", "pattern": "^BP-[A-Z0-9-]+$"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "risk": {"type": "object", "additionalProperties": false, "required": ["level", "reasons"], "properties": {"level": {"enum": ["L1", "L2", "L3"]}, "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["include", "exclude", "product_changes_allowed", "database_operations_allowed"], "properties": {"include": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "exclude": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "product_changes_allowed": {"type": "boolean"}, "database_operations_allowed": {"type": "boolean"}}},
    "allowed_paths": {"type": "object", "additionalProperties": false, "required": ["read", "write"], "properties": {"read": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "write": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "agent_assignments": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["role", "allowed_read_paths", "allowed_write_paths"], "properties": {"role": {"type": "string", "minLength": 1}, "allowed_read_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "allowed_write_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}}}},
    "review_assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assignment_id", "required_role_id", "agent_profile_reference", "agent_profile_sha256", "allowed_read_paths", "allowed_write_paths", "required_review_scope", "execution_mode", "implementation_participation"],
        "properties": {
          "assignment_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,127}$"},
          "required_role_id": {"type": "string", "minLength": 1},
          "agent_profile_reference": {"type": "string", "minLength": 1},
          "agent_profile_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
          "allowed_read_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "allowed_write_paths": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
          "required_review_scope": {"type": "string", "minLength": 1},
          "execution_mode": {"const": "read-only"},
          "implementation_participation": {"const": false}
        }
      }
    },
    "applicable_rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidate_rules": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_agents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["parallel_groups", "sequential_steps"], "properties": {"parallel_groups": {"type": "array"}, "sequential_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "evidence_required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rollback_restore": {"type": "object", "additionalProperties": false, "required": ["required", "evidence_or_reason"], "properties": {"required": {"type": "boolean"}, "evidence_or_reason": {"type": "string", "minLength": 1}}},
    "human_approval": {"type": "object", "additionalProperties": false, "required": ["required", "approver_roles"], "properties": {"required": {"type": "boolean"}, "approver_roles": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
