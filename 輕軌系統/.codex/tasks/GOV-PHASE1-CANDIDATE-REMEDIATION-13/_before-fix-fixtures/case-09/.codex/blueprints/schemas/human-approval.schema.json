{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ntmc.local/codex/schemas/human-approval.schema.json",
  "x-governance-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "required", "status", "approvals", "prohibited_until_approved"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "required": {"type": "boolean"},
    "status": {"enum": ["pending", "approved", "rejected", "not-required"]},
    "approvals": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["stage", "status", "by", "at", "reason"], "properties": {"stage": {"enum": ["scope_approval", "execution_approval", "review_completion", "final_commit_approval"]}, "status": {"enum": ["pending", "approved", "rejected", "not-required"]}, "by": {"type": "string", "minLength": 1}, "at": {"type": "string", "format": "date-time"}, "reason": {"type": "string", "minLength": 1}}}},
    "bootstrap_candidate_ref": {"type": "string", "minLength": 1},
    "bootstrap_scanner_report_ref": {"type": "string", "minLength": 1},
    "bootstrap_candidate_subject_task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "session_b_outcome": {"enum": ["PASS", "PASS_WITH_CONDITIONS", "BLOCKER", "NOT_STARTED"]},
    "human_exact_manifest_approved": {"type": "boolean"},
    "post_review_baseline_unchanged": {"type": "boolean"},
    "bootstrap_commit_sha": {"type": "string", "pattern": "^[A-F0-9]{40,64}$"},
    "bootstrap_manifest_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "human_bootstrap_attestation": {"type": "string", "minLength": 1},
    "prohibited_until_approved": {"type": "array", "items": {"type": "string"}}
  }
}
