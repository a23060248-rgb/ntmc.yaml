{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ntmc.local/codex/schemas/railway-domain-review.schema.json",
  "x-governance-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["review_scope", "reviewer_binding", "governance_mechanism_outcome", "external_decisions"],
  "properties": {
    "review_scope": {"const": "bootstrap_rule_governance_mechanism"},
    "reviewer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_role_id", "agent_profile_reference", "agent_profile_sha256", "task_assignment_id", "reviewer_run_id", "session_id", "formal", "execution_mode", "implementation_participation", "reviewer_identity_assurance"],
      "properties": {
        "canonical_role_id": {"const": "railway-domain-reviewer"},
        "agent_profile_reference": {"const": ".codex/agents/railway-domain-reviewer.toml"},
        "agent_profile_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "task_assignment_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,127}$"},
        "reviewer_run_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "formal": {"const": true},
        "execution_mode": {"const": "read-only"},
        "implementation_participation": {"const": false},
        "reviewer_identity_assurance": {"const": "procedural_role_and_assignment_binding"}
      }
    },
    "governance_mechanism_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "findings"],
      "properties": {
        "outcome": {"enum": ["PASS", "PASS_WITH_CONDITIONS", "BLOCKER"]},
        "findings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "external_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_scope", "outcome", "affects_gate", "decision_owner_role", "decision_question"],
        "properties": {
          "decision_scope": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["NEEDS_HUMAN_DECISION", "RESOLVED"]},
          "affects_gate": {"const": "migration_320_execution"},
          "decision_owner_role": {"type": "string", "minLength": 1},
          "decision_question": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
