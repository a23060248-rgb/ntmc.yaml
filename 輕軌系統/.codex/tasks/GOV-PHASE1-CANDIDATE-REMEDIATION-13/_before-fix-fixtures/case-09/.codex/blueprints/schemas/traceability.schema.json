{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ntmc.local/codex/schemas/traceability.schema.json",
  "x-governance-schema-version": 1,
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "task_id", "generated_at", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "type", "label", "source_ref"], "properties": {"id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "source_ref": {"type": "string", "minLength": 1}}}},
    "edges": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["from", "relation", "to", "source_ref"], "properties": {"from": {"type": "string", "minLength": 1}, "relation": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "source_ref": {"type": "string", "minLength": 1}}}}
  }
}
