{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magp:source-scope-reviewer-return-payload:r1",
  "title": "MAGP Source Scope Reviewer Canonical Return Wrapper R1",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload_core", "payload_core_sha256"],
  "properties": {
    "payload_core": {"$ref": "#/$defs/payload_core"},
    "payload_core_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  },
  "$defs": {
    "payload_core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version","review_package_id","review_package_core_sha256","task_id","reviewer_role","assignment_id","reviewer_run_id","reviewer_session_nonce","review_target_binding","startup","review_status","review_started","source_content_reviewed","completed","mandatory_exit_requested","findings","access_log","clean_context_attestation"],
      "properties": {
        "schema_version": {"const": 1},
        "review_package_id": {"type": "string", "minLength": 16},
        "review_package_core_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "task_id": {"type": "string", "minLength": 16},
        "reviewer_role": {"enum": ["EXTERNAL_SOURCE_INTEGRITY_REVIEWER","EXTERNAL_SOURCE_AUTHORITY_REVIEWER","EXTERNAL_SCOPE_CONTAMINATION_REVIEWER","EXTERNAL_COMPATIBILITY_REVIEWER"]},
        "assignment_id": {"type": "string", "minLength": 16},
        "reviewer_run_id": {"type": "string", "minLength": 16},
        "reviewer_session_nonce": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "review_target_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_target_task_id","review_target_manifest_sha256","review_target_record_core_sha256","source_directory_manifest_sha256","source_hash_binding_sha256"],
          "properties": {
            "review_target_task_id": {"const": "GOV-MAGP-CORE-SOURCE-SCOPE-AND-AUTHORITY-LOCK-01"},
            "review_target_manifest_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
            "review_target_record_core_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
            "source_directory_manifest_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
            "source_hash_binding_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
          }
        },
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status","assignment_valid","package_valid","target_valid","scope_valid","clean_context_valid"],
          "properties": {
            "status": {"enum": ["STARTUP_VALID","STARTUP_BLOCKER"]},
            "assignment_valid": {"type": "boolean"},
            "package_valid": {"type": "boolean"},
            "target_valid": {"type": "boolean"},
            "scope_valid": {"type": "boolean"},
            "clean_context_valid": {"type": "boolean"}
          }
        },
        "review_status": {"enum": ["PASS","BLOCKER"]},
        "review_started": {"type": "boolean"},
        "source_content_reviewed": {"type": "boolean"},
        "completed": {"type": "boolean"},
        "mandatory_exit_requested": {"type": "boolean"},
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        },
        "access_log": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["absolute_path","access_type","content_scope","status"],
            "properties": {
              "absolute_path": {"type": "string", "pattern": "^[A-Za-z]:/"},
              "access_type": {"const": "READ"},
              "content_scope": {"enum": ["FULL_ARTIFACT","FULL_CORE_SOURCE","GENERAL_PATTERN_ONLY","MINIMAL_EXCLUSION_EVIDENCE","METADATA_AND_HASH_ONLY"]},
              "status": {"enum": ["ALLOWED_READ","DENIED_NOT_READ"]}
            }
          }
        },
        "clean_context_attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["brand_new_top_level_codex_chat","preparation_conversation_memory_used","other_reviewer_conversation_used","other_reviewer_payload_used","implementation_conversation_used","subagents_used","reviewer_repository_write_count","forbidden_read_count","out_of_scope_read_count"],
          "properties": {
            "brand_new_top_level_codex_chat": {"const": true},
            "preparation_conversation_memory_used": {"const": false},
            "other_reviewer_conversation_used": {"const": false},
            "other_reviewer_payload_used": {"const": false},
            "implementation_conversation_used": {"const": false},
            "subagents_used": {"const": false},
            "reviewer_repository_write_count": {"const": 0},
            "forbidden_read_count": {"const": 0},
            "out_of_scope_read_count": {"const": 0}
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id","severity","status","title","description","evidence_paths","affected_policy","required_remediation"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 8},
        "severity": {"enum": ["CRITICAL","HIGH","MEDIUM","LOW"]},
        "status": {"enum": ["OPEN","CLOSED"]},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "evidence_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z]:/"}},
        "affected_policy": {"type": "string", "minLength": 1},
        "required_remediation": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"payload_core": {"properties": {"review_status": {"const": "PASS"}}}}},
      "then": {"properties": {"payload_core": {"properties": {"startup": {"properties": {"status": {"const": "STARTUP_VALID"},"assignment_valid":{"const":true},"package_valid":{"const":true},"target_valid":{"const":true},"scope_valid":{"const":true},"clean_context_valid":{"const":true}}},"review_started":{"const":true},"completed":{"const":true},"mandatory_exit_requested":{"const":true}}}}}
    }
  ]
}
