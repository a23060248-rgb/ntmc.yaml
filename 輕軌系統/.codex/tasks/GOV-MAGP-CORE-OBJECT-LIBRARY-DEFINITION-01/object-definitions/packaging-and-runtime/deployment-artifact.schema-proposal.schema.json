{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magp:proposal:schema:deployment-artifact:v0",
  "title": "Deployment Artifact Schema Proposal",
  "description": "Candidate schema proposal; not adopted and not a database schema.",
  "allOf": [
    {
      "$ref": "../../../canonical-object-envelope/canonical-object-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "identity": {
          "type": "object",
          "properties": {
            "object_type": {
              "const": "DEPLOYMENT_ARTIFACT"
            }
          }
        },
        "payload": {
          "type": "object",
          "required": [
            "artifact_identity",
            "build_identity",
            "source_package_binding",
            "architecture_conformance_result",
            "security_validation_result",
            "approval_binding",
            "environment_eligibility",
            "immutable_hash",
            "rollback_artifact",
            "deployment_status"
          ],
          "properties": {
            "artifact_identity": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "build_identity": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "source_package_binding": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "architecture_conformance_result": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "security_validation_result": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "approval_binding": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "environment_eligibility": {
              "type": [
                "string",
                "number",
                "boolean",
                "array",
                "object",
                "null"
              ]
            },
            "immutable_hash": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "rollback_artifact": {
              "type": [
                "string",
                "number",
                "boolean",
                "array",
                "object",
                "null"
              ]
            },
            "deployment_status": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "payload"
      ]
    }
  ],
  "x-magp-object-type-id": "OBJ-TYPE-021",
  "x-magp-proposal-status": "PROPOSED_NOT_ADOPTED",
  "x-magp-normative-object-library": false,
  "x-magp-human-adoption-required": true,
  "x-magp-database-schema": false
}
