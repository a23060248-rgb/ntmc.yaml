{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magp:proposal:schema:runtime-event:v0",
  "title": "Runtime Event Schema Proposal",
  "description": "Candidate schema proposal; not adopted and not a database schema.",
  "allOf": [
    {
      "$ref": "../../../canonical-object-envelope/canonical-object-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "identity": {
          "type": "object",
          "properties": {
            "object_type": {
              "const": "RUNTIME_EVENT"
            }
          }
        },
        "payload": {
          "type": "object",
          "required": [
            "event_identity",
            "event_type",
            "producer",
            "subject",
            "timestamp",
            "sequence",
            "correlation_identity",
            "causation_identity",
            "payload_hash",
            "severity",
            "handling_status",
            "evidence_classification"
          ],
          "properties": {
            "event_identity": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "event_type": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "producer": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "subject": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "sequence": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "correlation_identity": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "causation_identity": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "payload_hash": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "severity": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "handling_status": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "evidence_classification": {
              "type": [
                "string",
                "number",
                "boolean",
                "array",
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "payload"
      ]
    }
  ],
  "x-magp-object-type-id": "OBJ-TYPE-020",
  "x-magp-proposal-status": "PROPOSED_NOT_ADOPTED",
  "x-magp-normative-object-library": false,
  "x-magp-human-adoption-required": true,
  "x-magp-database-schema": false
}
