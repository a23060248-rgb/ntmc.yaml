{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magp:proposal:schema:human-approval:v0",
  "title": "Human Approval Schema Proposal",
  "description": "Candidate schema proposal; not adopted and not a database schema.",
  "allOf": [
    {
      "$ref": "../../../canonical-object-envelope/canonical-object-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "identity": {
          "type": "object",
          "properties": {
            "object_type": {
              "const": "HUMAN_APPROVAL"
            }
          }
        },
        "payload": {
          "type": "object",
          "required": [
            "approval_subject",
            "exact_artifact_hash",
            "approved_scope",
            "excluded_scope",
            "assurance_acknowledgement",
            "approver_authority",
            "decision_timestamp",
            "expiry_review_date",
            "revocation_mechanism"
          ],
          "properties": {
            "approval_subject": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "exact_artifact_hash": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "approved_scope": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "excluded_scope": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "assurance_acknowledgement": {
              "type": [
                "string",
                "number",
                "boolean",
                "array",
                "object",
                "null"
              ]
            },
            "approver_authority": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "decision_timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "expiry_review_date": {
              "type": [
                "string",
                "number",
                "boolean",
                "array",
                "object",
                "null"
              ]
            },
            "revocation_mechanism": {
              "type": [
                "string",
                "number",
                "boolean",
                "array",
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "payload"
      ]
    }
  ],
  "x-magp-object-type-id": "OBJ-TYPE-008",
  "x-magp-proposal-status": "PROPOSED_NOT_ADOPTED",
  "x-magp-normative-object-library": false,
  "x-magp-human-adoption-required": true,
  "x-magp-database-schema": false
}
