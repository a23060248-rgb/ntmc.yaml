{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magp:proposal:schema:evidence:v0",
  "title": "Evidence Schema Proposal",
  "description": "Candidate schema proposal; not adopted and not a database schema.",
  "allOf": [
    {
      "$ref": "../../../canonical-object-envelope/canonical-object-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "identity": {
          "type": "object",
          "properties": {
            "object_type": {
              "const": "EVIDENCE"
            }
          }
        },
        "payload": {
          "type": "object",
          "required": [
            "evidence_id",
            "evidence_type",
            "producer",
            "subject",
            "collection_method",
            "collection_time",
            "source_location",
            "content_hash",
            "chain_of_custody",
            "validation_status",
            "assurance_level",
            "expiration",
            "limitations"
          ],
          "properties": {
            "evidence_id": {
              "type": [
                "string",
                "number",
                "boolean",
                "array",
                "object",
                "null"
              ]
            },
            "evidence_type": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "producer": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "subject": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "collection_method": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "collection_time": {
              "type": "string",
              "format": "date-time"
            },
            "source_location": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "chain_of_custody": {
              "type": [
                "string",
                "number",
                "boolean",
                "array",
                "object",
                "null"
              ]
            },
            "validation_status": {
              "type": [
                "string",
                "object",
                "array",
                "number",
                "null"
              ]
            },
            "assurance_level": {
              "type": [
                "string",
                "number",
                "boolean",
                "array",
                "object",
                "null"
              ]
            },
            "expiration": {
              "type": [
                "string",
                "number",
                "boolean",
                "array",
                "object",
                "null"
              ]
            },
            "limitations": {
              "type": "array",
              "items": {}
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "payload"
      ]
    }
  ],
  "x-magp-object-type-id": "OBJ-TYPE-013",
  "x-magp-proposal-status": "PROPOSED_NOT_ADOPTED",
  "x-magp-normative-object-library": false,
  "x-magp-human-adoption-required": true,
  "x-magp-database-schema": false
}
