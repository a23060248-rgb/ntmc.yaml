# Copy to .env.test. This file must point only to a disposable local database.
NODE_ENV=test
PORT=3102
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/ntmc_erp_rehearsal_CHANGE_ME
DATABASE_SSL=false
DATABASE_SAFETY_MODE=rehearsal
DATABASE_ALLOWED_NAME_PATTERN=^ntmc_erp_rehearsal_[a-zA-Z0-9_]+$
AUTH_MODE=preview
PREVIEW_USER_ROLE=system_admin
WORD_TEMPLATE_ROOT=C:\path\to\rehearsal-word-templates
WORD_OUTPUT_DIR=C:\path\to\rehearsal-word-output
