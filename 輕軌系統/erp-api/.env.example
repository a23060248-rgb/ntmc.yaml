# 複製成 .env 再填實際值（.env 不進版控）。
# 兩台電腦要「共用同一份資料」→ 兩邊填【同一條】雲端 DATABASE_URL。
# 真實值見：公司那台的 erp-api/.env，或 Zeabur 後台該 Postgres 的連線字串。
PORT=3001
DATABASE_URL=postgresql://root:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/zeabur
CORS_ORIGIN=http://127.0.0.1:3001
DATABASE_SSL=false
AUTH_MODE=api
PREVIEW_USER_ROLE=system_admin
SERVE_FRONTEND=true
SESSION_COOKIE_NAME=ntmc_session
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15
WORD_TEMPLATE_ROOT=C:\\path\\to\\approved-word-templates
WORD_OUTPUT_DIR=C:\\path\\to\\generated-word-output
